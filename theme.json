{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "White", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Ink", "color": "#14212B" },
				{ "slug": "accent-1", "name": "Signal amber", "color": "#F2A93B" },
				{ "slug": "accent-2", "name": "Petrol", "color": "#0E5E6F" },
				{ "slug": "accent-3", "name": "Steel", "color": "#5B6770" },
				{ "slug": "accent-4", "name": "Concrete", "color": "#F4F2EE" },
				{ "slug": "accent-5", "name": "Rule", "color": "#DAD6CF" },
				{ "slug": "accent-6", "name": "Petrol tint", "color": "#E3EEF0" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Archivo",
					"slug": "archivo",
					"fontFamily": "Archivo, sans-serif",
					"fontFace": [
						{ "fontFamily": "Archivo", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "/wp-content/uploads/fonts/archivo-600.woff2" ] },
						{ "fontFamily": "Archivo", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "/wp-content/uploads/fonts/archivo-700.woff2" ] }
					]
				},
				{
					"name": "IBM Plex Sans",
					"slug": "ibm-plex-sans",
					"fontFamily": "\"IBM Plex Sans\", sans-serif",
					"fontFace": [
						{ "fontFamily": "IBM Plex Sans", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "/wp-content/uploads/fonts/ibm-plex-sans-400.woff2" ] },
						{ "fontFamily": "IBM Plex Sans", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "/wp-content/uploads/fonts/ibm-plex-sans-500.woff2" ] },
						{ "fontFamily": "IBM Plex Sans", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "/wp-content/uploads/fonts/ibm-plex-sans-600.woff2" ] }
					]
				},
				{
					"name": "IBM Plex Mono",
					"slug": "ibm-plex-mono",
					"fontFamily": "\"IBM Plex Mono\", monospace",
					"fontFace": [
						{ "fontFamily": "IBM Plex Mono", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "/wp-content/uploads/fonts/ibm-plex-mono-500.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1.0625rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.375rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.75rem", "fluid": { "min": "2.125rem", "max": "3.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"letterSpacing": "0",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontWeight": "700",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "1.125rem" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-2)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
			},
			"button": {
				"border": { "radius": "8px" },
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"spacing": {
					"padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.4rem", "right": "1.4rem" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontSize": "1rem",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "#E0952A",
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		}
	}
}
